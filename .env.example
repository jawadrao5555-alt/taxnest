# TaxNest local / Cloud Agent development environment
#
# Copy to .env and generate a key:
#   cp .env.example .env
#   php artisan key:generate
#
# Or use the idempotent bootstrap:
#   bash scripts/cloud-dev-bootstrap.sh
#
# NEVER put production secrets, FBR/PRA tokens, SSH keys, mail passwords,
# Cloudflare tokens, customer credentials, or live DB passwords in this file.

APP_NAME=TaxNest
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Karachi

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Local MariaDB only (created by scripts/cloud-dev-bootstrap.sh).
# These credentials are LOCAL DEVELOPMENT PLACEHOLDERS — not production.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=taxnest_dev
DB_USERNAME=taxnest_dev
DB_PASSWORD=taxnest_local_dev_only

SESSION_DRIVER=file
SESSION_LIFETIME=120

BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
