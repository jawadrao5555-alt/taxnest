# Deliberately non-secret test-only environment. PHPUnit force-overrides the
# same settings; this file also lets `php artisan test` bootstrap cleanly
# before PHPUnit reads phpunit.xml.
APP_ENV=testing
APP_KEY=base64:2fl+KTVYFIEjblwNh83EzNpx7dLTs7jK7dbRbUYx21E=
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=4
BROADCAST_CONNECTION=null
CACHE_STORE=array
DB_CONNECTION=sqlite
DB_DATABASE=:memory:
MAIL_MAILER=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false