modules = ["php-8.4", "nodejs-20", "python-3.11", "postgresql-16"]
[agent]
expertMode = true
integrations = ["github:1.0.0"]

[userenv]

[userenv.shared]
APP_URL = "https://deeb2ffc-615d-44ed-a0cd-b1cde9f84756-00-24lu1hpq4f5ka.worf.replit.dev"
DB_CONNECTION = "pgsql"
SESSION_SECURE_COOKIE = "true"
SESSION_SAME_SITE = "none"
SESSION_DOMAIN = ""
SESSION_PARTITIONED_COOKIE = "true"
FBR_PROXY_URL = "https://nestpay.replit.app/api/fbr-proxy/submit"
ASSET_URL = "/"
SESSION_DRIVER = "file"
CACHE_STORE = "file"
QUEUE_CONNECTION = "sync"
PRA_PROXY_URL = "https://nestpay.replit.app/api/pra-proxy/submit"
VAPID_SUBJECT = "mailto:admin@taxnest.com.pk"
CPANEL_SSH_HOST = "taxnest.com.pk"
CPANEL_SSH_PORT = "22"
CPANEL_SSH_USERNAME = "taxnestc"

[userenv.production]
APP_ENV = "production"
APP_DEBUG = "false"
DB_HOST = "169.254.254.254"
DB_DATABASE = "neondb"
DB_USERNAME = "neondb_owner"
DB_PORT = "5432"

[userenv.development]
APP_ENV = "production"
APP_DEBUG = "false"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Laravel Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Queue Worker"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "MySQL Staging"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Video Batch"

[[workflows.workflow]]
name = "Laravel Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "env -u DATABASE_URL -u DB_CONNECTION -u PGHOST -u PGPORT -u PGUSER -u PGPASSWORD -u PGDATABASE PHP_CLI_SERVER_WORKERS=8 php artisan serve --host=0.0.0.0 --port=5000 --no-reload"
waitForPort = 5000

[[workflows.workflow]]
name = "Queue Worker"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "env -u DATABASE_URL -u DB_CONNECTION -u PGHOST -u PGPORT -u PGUSER -u PGPASSWORD -u PGDATABASE QUEUE_CONNECTION=database php artisan queue:work"

[[workflows.workflow]]
name = "MySQL Staging"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "mysqld --defaults-file=/home/runner/workspace/.local/mysql_run/my.cnf"

[[workflows.workflow]]
name = "test"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "env -u DATABASE_URL -u DB_CONNECTION -u PGHOST -u PGPORT -u PGUSER -u PGPASSWORD -u PGDATABASE APP_ENV=testing DB_CONNECTION=sqlite DB_DATABASE=':memory:' CACHE_STORE=array php vendor/bin/phpunit"

[[workflows.workflow]]
name = "Video Batch"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash tools/video-pipeline/batch-new11.sh"

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 9000
externalPort = 9000

[[ports]]
localPort = 23636
externalPort = 80

[nix]
channel = "stable-25_05"

[deployment]
deploymentTarget = "autoscale"
run = ["php", "-S", "0.0.0.0:23636", "replit-holding/server.php"]
build = ["bash", "-c", "echo 'holding page: no build needed'"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000
