<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- In-app update: APK download ke baad Android ka install prompt kholne ke liye -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
      Task 1345 — call-detection ka hissa YAHAN NAHI hai, har build ke apne
      manifest mein hai:
        src/sim/AndroidManifest.xml   → READ_PHONE_STATE + READ_CALL_LOG + PhoneStateReceiver
        src/plus/AndroidManifest.xml  → NotificationListenerService (SIM + WhatsApp)

      Google Play Protect ki "enhanced fraud protection" sideload install
      automatically block kar deti hai agar manifest mein RECEIVE_SMS, READ_SMS,
      notification-listener ya accessibility ho. Is shared manifest mein un chaar
      mein se koi nahi — is liye default (sim/"clean") build website se bina
      rukawat install hoti hai.
    -->

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_caller"
        android:theme="@style/Theme.TaxNestCaller"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false" />
    </application>
</manifest>
