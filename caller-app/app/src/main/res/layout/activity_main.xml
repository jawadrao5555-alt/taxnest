<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F8F9"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_caller"
                android:contentDescription="@string/app_name" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#0A4D5C" />

                <TextView
                    android:id="@+id/welcomeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#667085" />
            </LinearLayout>
        </LinearLayout>

        <!-- Build badge (Task 1345): saaf likha ho ke YEH build kaunsi calls
             pakadti hai — clean (sirf SIM) ya plus (SIM + WhatsApp). Text har
             flavor ki apni strings.xml se aata hai. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:background="#E6F4F1"
            android:padding="12dp">

            <TextView
                android:id="@+id/buildBadge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#0A4D5C" />

            <TextView
                android:id="@+id/buildBadgeRoman"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textSize="11sp"
                android:textColor="#475467" />
        </LinearLayout>

        <!-- Update row (hidden by default) -->
        <LinearLayout
            android:id="@+id/updateRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FEF3C7"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/update_available"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#92400E" />

            <Button
                android:id="@+id/updateBtn"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/update_btn"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#B45309" />
        </LinearLayout>

        <!-- Status card -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#0A4D5C" />

        <TextView
            android:id="@+id/permRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="13sp"
            android:textColor="#344054" />

        <Button
            android:id="@+id/permBtn"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:text="@string/perm_btn"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0A4D5C" />

        <TextView
            android:id="@+id/batteryRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textSize="13sp"
            android:textColor="#344054" />

        <Button
            android:id="@+id/batteryBtn"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:text="@string/battery_btn"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0A4D5C" />

        <TextView
            android:id="@+id/lastSentRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textSize="13sp"
            android:textColor="#027A48"
            android:visibility="gone" />

        <Button
            android:id="@+id/testBtn"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="18dp"
            android:text="@string/test_btn"
            android:textSize="14sp"
            android:textColor="#0A4D5C"
            android:backgroundTint="#E7BF3B" />

        <!-- How it works -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/howto_title"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#0A4D5C" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/howto_body"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp"
            android:textColor="#475467" />

        <Button
            android:id="@+id/logoutBtn"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="26dp"
            android:text="@string/logout_btn"
            android:textSize="13sp"
            android:textColor="#B42318"
            android:backgroundTint="#FEE4E2" />
    </LinearLayout>
</ScrollView>
