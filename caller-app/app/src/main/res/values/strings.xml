<?xml version="1.0" encoding="utf-8"?>
<!--
  DEFAULT (English) strings — Task 1382.

  Teen zubaanein, teen folders (Lang.kt):
    values/            → English      (default; fresh install yahin khulta hai)
    values-b+ur+Latn/  → Roman Urdu   (POS panel ke `lang/rur/pos.php` wala lehja)
    values-ur/         → Urdu script  (purana app text, jyun ka tyun)

  QAWAID:
   • Teenon files ka key set BILKUL barabar rahe. Ek key kisi zubaan mein kam
     ho to release build `MissingTranslation` (lint fatal) par girti hai, aur
     ziyada ho to `ExtraTranslation` par.
   • Jo string har zubaan mein aik hi rehni hai (app ka naam, `%s · %s` jaisa
     format) usay `translatable="false"` lagayein aur SIRF isi file mein rakhein.
   • Build-specific keys (build_badge / perm_* / howto_body) har flavor apni
     res se override karti hai — tafseel neeche.
-->
<resources>
    <!-- ── Language-neutral: har zubaan mein bilkul yehi ──────────────────── -->
    <string name="app_name" translatable="false">TaxNest Caller ID</string>
    <string name="login_title" translatable="false">TaxNest Caller ID</string>
    <string name="welcome_fmt" translatable="false">%1$s · %2$s</string>

    <!-- Language picker ke labels: har zubaan apne hi naam se (autonym), is
         liye inka tarjuma nahi hota. -->
    <string name="lang_en" translatable="false">English</string>
    <string name="lang_rur" translatable="false">Roman</string>
    <string name="lang_ur" translatable="false">اردو</string>

    <!-- Login -->
    <string name="login_hint">Sign in with the shop\'s admin or manager login — the same email and password that works on the portal</string>
    <string name="email">Email</string>
    <string name="password">Password</string>
    <string name="show_password">Show password</string>
    <string name="login_btn">Sign in</string>
    <string name="fill_both">Enter both the email and the password</string>
    <string name="network_error">Internet problem — please try again</string>
    <string name="login_failed">Sign-in failed — check the email or password</string>

    <!-- Main -->
    <string name="status_ok">✔ All set — a popup will appear on the POS screen as soon as a call comes in</string>
    <string name="status_feature_off">Caller ID is switched off in POS settings — turn it on from the portal</string>

    <string name="battery_on">✔ Battery setting is fine — the app will keep running in the background</string>
    <string name="battery_off">✖ Battery optimisation is on — the app can fall asleep sometimes</string>
    <string name="battery_btn">Allow battery permission</string>
    <!-- Play build battery ki LIST kholti hai (uske paas seedhi permission nahi) -->
    <string name="battery_list_toast">Find TaxNest Caller ID in the list and set it to \"Don\'t optimize / Unrestricted\"</string>

    <!-- v1.5.0 — sirf us build par dikhta hai jo yeh permissions maangti hai
         (aaj: plus). Phone + call log = SIM ka asli number; contacts = WhatsApp
         par saved contact ka number, kyunki WhatsApp sirf naam bhejta hai. -->
    <string name="extra_perms_toast">Please allow phone and contacts access — without it the counter sees only the caller\'s name, not the number</string>

    <string name="test_btn">Send a test ring</string>
    <string name="test_sent">Test sent — check for the popup on the POS sale screen</string>
    <string name="feature_off_toast">Caller ID is switched off in POS settings — turn it on from the portal first</string>

    <string name="last_sent_fmt">Last call sent: %1$s</string>
    <string name="just_now">just now</string>
    <string name="mins_ago_fmt">%1$d minutes ago</string>

    <string name="update_available">A new version is available</string>
    <string name="update_btn">Update</string>
    <!-- Website builds ke self-update toasts (src/web/java/UpdateCheck.kt).
         Play build inhe istemal nahi karti. -->
    <string name="update_downloading">The update is downloading…</string>
    <string name="update_downloaded">Download finished — install it from the notification.</string>
    <string name="logout_btn">Log out</string>

    <string name="howto_title">How does this work?</string>

    <!--
      ── Build-specific strings (Task 1345 / 1382) ───────────────────────────
      Neeche wali values "clean" (sim) build ki hain — yehi default download hai.
      `plus` aur `play` builds inhe apni res se override karti hain:
        build_badge                          → src/plus/res + src/play/res
        perm_* / status_need_permission /
        howto_body                           → src/notif/res (dono notif builds)
      Override HAR zubaan ke liye alag se likhna parta hai (values, values-ur,
      values-b+ur+Latn) — sirf English override karne se Urdu mode mein clean
      build wala text reh jata hai.

      Task 1382 se badge ek hi line hai: pehle Urdu line + neeche Roman line
      hoti thi (`build_badge_roman`), ab zubaan user khud chunta hai is liye
      dohra text hata diya gaya.
    -->
    <string name="build_badge">This build catches SIM (normal) calls only — not WhatsApp calls. For WhatsApp calls, get the \"WhatsApp\" APK from the website.</string>

    <string name="perm_on">✔ Phone and call log permission granted</string>
    <string name="perm_off">✖ No phone and call log permission — without it the app cannot read the caller\'s number</string>
    <string name="perm_btn">Allow call permission</string>
    <string name="perm_toast">To allow it, turn on Phone and Call logs under Permissions</string>
    <string name="status_need_permission">Allow call permission first — tap the button below</string>

    <string name="howto_body">This app sends the number of every normal (SIM) call that reaches the shop\'s phone to your POS — a popup appears on the sale screen right away showing which customer is calling and what they bought before. You do not have to keep the app open, the phone just has to be on.\n\nThis build does not catch WhatsApp calls. If you need WhatsApp calls too, get the \"WhatsApp\" app from the download page on the website.</string>
</resources>
