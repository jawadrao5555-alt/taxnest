<?xml version="1.0" encoding="utf-8"?>
<!--
  Chhoti shared styles. NOTE: themes.xml play flavor mein override hoti hai
  (src/play/res/values/themes.xml), is liye ghair-theme styles yahan rakhein —
  warna Play build mein yeh style ghayab ho sakti hai.
-->
<resources>

    <!-- Language picker ka ek pill (Task 1382). -->
    <style name="LangPill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">52dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">7dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/lang_pill_text</item>
        <item name="android:background">@drawable/lang_pill</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
