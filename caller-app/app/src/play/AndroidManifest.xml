<?xml version="1.0" encoding="utf-8"?>
<!--
  "play" build — Google Play ke liye (Task 1346).

  Detection plus build jaisi hi hai (SIM + WhatsApp, notification listener):
  Play Protect ka sideload-block Play Store se aane wali app par lagta hi nahi,
  is liye poori app bila-rukawat chalti hai.

  DO cheezein is build mein JAAN-BOOJH kar nahi hain:
   1. REQUEST_INSTALL_PACKAGES — Play ki Device and Network Abuse policy mein
      "app khud ko update kare" jaiz istemal ki list mein NAHI hai. Neeche
      tools:node="remove" isay shared manifest se nikal deta hai, aur
      src/web/java (download + install code) is flavor mein compile hi nahi
      hota. Update Play Store deti hai.
   2. REQUEST_IGNORE_BATTERY_OPTIMIZATIONS — is permission ke saath seedha
      "allow?" dialog kholna Play par sirf chand manzoor-shuda use cases mein
      jaiz hai. Is ke baghair app battery ki settings ki LIST kholti hai
      (MainActivity khud check karti hai ke permission hai ya nahi) — wohi
      rasta Play par mehfooz hai.

  READ_PHONE_STATE / READ_CALL_LOG bhi is build mein nahi (woh sirf website ki
  clean build mein hain) — is liye Play Console ka Call Log permissions
  declaration form bhi lagu nahi hota.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" tools:node="remove" />

    <!-- Android 11+ package visibility: is ke baghair phone ki dialer apps ki
         fehrist khali aati hai aur CallSourceRules SIM ki ring ko pehchan nahi
         pata. Sirf calling apps dikhti hain — QUERY_ALL_PACKAGES nahi (us par
         Play ka alag declaration form lagta hai). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
    </queries>

    <application>
        <!-- Event-driven, battery-friendly: Android khud call/WhatsApp notification
             par service jagata hai — koi foreground service ya polling nahi. -->
        <service
            android:name=".CallListenerService"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Prominent disclosure — notification access se pehle (Play User Data policy) -->
        <activity
            android:name=".NotificationDisclosureActivity"
            android:exported="false" />
    </application>
</manifest>
