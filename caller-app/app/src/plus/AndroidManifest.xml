<?xml version="1.0" encoding="utf-8"?>
<!--
  "plus" build — SIM + WhatsApp (pehle wali behaviour, jyun ki tyun).

  BIND_NOTIFICATION_LISTENER_SERVICE Play Protect ki blocked chaar mein se ek
  hai: yeh APK browser/WhatsApp/file manager se install karte waqt "App blocked
  to protect your device" de sakti hai. Shop ko pehle Play Protect ka scan
  waqti tor par band karna parta hai (steps /download page aur POS → Customize
  par likhe hain), install ke baad dobara ON.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- SIM ka number (v1.5.0). Sirf notification par bharosa karne se saved
         contact ki call par number milta hi nahi tha — dialer apne notification
         mein number ki jagah contact ka NAAM likhta hai, aur counter par "No
         phone" aata tha. Ab is build mein bhi clean build wala telephony
         detector hai (PhoneStateReceiver, src/telephony), jo har SIM ring ka
         asli number deta hai — save ho ya na ho.
         READ_CALL_LOG lazmi hai: Android 9+ par uske baghair
         EXTRA_INCOMING_NUMBER khali aata hai. Dono Play Protect ki blocked
         chaar mein NAHI hain, aur is build par waise bhi notification-listener
         ki wajah se Play Protect band karni parti hai. Play manifest mein yeh
         KABHI nahi jana (Call Log declaration form). -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />

    <!-- WhatsApp ka number (v1.5.0). WhatsApp saved contact ki call par apni
         notification mein sirf naam deta hai, number deta hi nahi. Us naam ka
         number phone ki apni contact list se nikala jata hai
         (ContactNumberLookup, sirf is build mein) — bilkul wahi naam, aur sirf
         tab jab us naam ka ek hi number ho. Contacts kabhi server par nahi
         jati; sirf jis ne call ki hai us ka number jata hai. Play build mein
         yeh permission nahi hai (wahan lookup ka no-op version compile hota
         hai). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Task 1381 (call back) — hu-ba-hu src/sim/AndroidManifest.xml jaisa
         block; ek source set ka ek hi manifest hota hai is liye duplication
         majboori hai. Ek jagah badlein to doosri bhi badlein. Play build ke
         manifest mein yeh KABHI nahi jana. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Android 11+ package visibility: is ke baghair phone ki dialer apps ki
         fehrist khali aati hai aur CallSourceRules SIM ki ring ko pehchan nahi
         pata. Sirf calling apps dikhti hain — QUERY_ALL_PACKAGES nahi. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
    </queries>

    <!-- android:name sirf website builds mein: src/main ka <application> koi
         name set nahi karta, is liye merge sirf yeh add karta hai. -->
    <application android:name=".CallerApp">
        <!-- Event-driven, battery-friendly: Android khud call/WhatsApp notification
             par service jagata hai — koi foreground service ya polling nahi.
             (Task 1381 ki dial-watch service is se alag hai — woh POS se aane
             wali call-back request ke liye hai, call detection ke liye nahi.) -->
        <service
            android:name=".CallListenerService"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- SIM ki ring, Android ke apne telephony broadcast se (v1.5.0) —
             hu-ba-hu src/sim/AndroidManifest.xml wala receiver, kyunki ab
             src/telephony dono website builds mein compile hota hai.
             Manifest-registered hai: app band ho tab bhi Android jagata hai.
             Jab tak yeh chalta hai, CallListenerService dialer ki notification
             ko haath nahi lagati — warna ek hi call ke do popup jate. -->
        <receiver
            android:name=".PhoneStateReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <!-- Prominent disclosure — notification access se pehle (Task 1346).
             Play ki User Data policy ki shart hai, aur website wali is build
             par bhi wohi saaf screen dikhti hai. -->
        <activity
            android:name=".NotificationDisclosureActivity"
            android:exported="false" />

        <!-- Task 1381: POS ki dial request ka intezar (foreground, dataSync). -->
        <service
            android:name=".DialWatchService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Notification tap ka trampoline — dialer kholta hai, koi UI nahi. -->
        <activity
            android:name=".DialActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <receiver
            android:name=".DialBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
