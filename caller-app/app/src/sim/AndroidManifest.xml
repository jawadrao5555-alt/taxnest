<?xml version="1.0" encoding="utf-8"?>
<!--
  "clean" (sim) build — DEFAULT download.

  Play Protect ki blocked chaar (RECEIVE_SMS, READ_SMS, notification-listener,
  accessibility) mein se yahan koi nahi, is liye website se install par koi
  "App blocked to protect your device" nahi aata.

  READ_PHONE_STATE = RINGING state, READ_CALL_LOG = incoming number
  (Android 9+ par number is ke baghair khali aata hai). Dono blocked list se
  bahar hain. WhatsApp calls yeh build detect NAHI karti — uske liye plus build.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />

    <!-- Task 1381 (call back) — chaaron blocked list se BAHAR hain, is liye
         website install par abhi bhi koi "App blocked" nahi aata. Yeh block
         hu-ba-hu src/plus/AndroidManifest.xml mein bhi hai: ek source set ka
         ek hi manifest hota hai, is liye duplication majboori hai — ek jagah
         badlein to doosri bhi badlein. Play build ke manifest mein yeh KABHI
         nahi jana. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- android:name sirf website builds mein: src/main ka <application> koi
         name set nahi karta, is liye merge sirf yeh add karta hai. -->
    <application android:name=".CallerApp">
        <!-- Manifest-registered: app band ho tab bhi Android jagata hai.
             PHONE_STATE implicit-broadcast pabandi se mustasna hai. -->
        <receiver
            android:name=".PhoneStateReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <!-- Task 1381: POS ki dial request ka intezar (foreground, dataSync). -->
        <service
            android:name=".DialWatchService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Notification tap ka trampoline — dialer kholta hai, koi UI nahi. -->
        <activity
            android:name=".DialActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <receiver
            android:name=".DialBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
