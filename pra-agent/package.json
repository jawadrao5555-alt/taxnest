{
  "name": "taxnest-pra-agent",
  "version": "1.5.3",
  "description": "TaxNest PRA Sync Agent — auto-syncs your POS invoices to PRA from your local Pakistani PC.",
  "main": "main.js",
  "author": "TaxNest (Pvt) Ltd",
  "license": "Proprietary",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win --x64 --publish never",
    "publish:win": "electron-builder --win --x64 --publish always",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.taxnest.pra-agent",
    "productName": "TaxNest PRA Agent",
    "copyright": "Copyright (c) 2026 TaxNest",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "offline.html",
      "src/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "assets/nestpos.ico",
        "to": "nestpos.ico"
      },
      {
        "from": "assets/nestpos-256.png",
        "to": "nestpos.png"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "jawadrao5555-alt",
        "repo": "taxnest",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "TaxNest-Agent-Setup-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TaxNest PRA Agent",
      "uninstallDisplayName": "TaxNest PRA Agent",
      "deleteAppDataOnUninstall": false
    }
  }
}
