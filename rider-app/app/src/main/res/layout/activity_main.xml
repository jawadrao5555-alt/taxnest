<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F6F8F9">

    <!-- ── Fixed top: identity + summary ──────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="18dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/welcomeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#0A4D5C" />

        <TextView
            android:id="@+id/summaryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:textColor="#344054" />

        <!-- Update banner -->
        <LinearLayout
            android:id="@+id/updateRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="#FEF3C7"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/update_available"
                android:textColor="#92400E"
                android:textSize="13sp" />

            <Button
                android:id="@+id/updateBtn"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:text="@string/update_btn"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#B45309" />
        </LinearLayout>
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E4E7EC" />

    <!-- ── Scrollable middle: deliveries list ─────────────────────── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <!-- Section header -->
            <TextView
                android:id="@+id/deliveriesHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/deliveries_section"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#667085"
                android:textAllCaps="false"
                android:paddingBottom="6dp" />

            <!-- Empty state -->
            <TextView
                android:id="@+id/emptyDeliveriesText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_deliveries"
                android:textSize="14sp"
                android:textColor="#98A2B3"
                android:gravity="center"
                android:paddingTop="20dp"
                android:paddingBottom="20dp"
                android:visibility="gone" />

            <!-- Delivery rows injected here programmatically -->
            <LinearLayout
                android:id="@+id/deliveriesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E4E7EC" />

    <!-- ── Fixed bottom: duty controls ────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#344054" />

        <TextView
            android:id="@+id/pendingText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="#667085" />

        <Button
            android:id="@+id/dutyBtn"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/logoutBtn"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:text="@string/logout"
            android:textSize="13sp"
            android:textColor="#475467"
            style="?android:attr/borderlessButtonStyle" />
    </LinearLayout>

</LinearLayout>
