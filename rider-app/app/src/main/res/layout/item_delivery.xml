<?xml version="1.0" encoding="utf-8"?>
<!-- Single delivery row — inflated programmatically into deliveriesContainer -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="8dp"
    android:background="#FFFFFF"
    android:padding="12dp"
    android:elevation="1dp">

    <!-- Row 1: Bill no + Amount -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/invoiceNumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#101828" />

        <TextView
            android:id="@+id/amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#0A4D5C" />
    </LinearLayout>

    <!-- Row 2: Customer name + Payment method -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/customerName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textColor="#344054" />

        <TextView
            android:id="@+id/paymentMethod"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#667085" />
    </LinearLayout>

    <!-- Row 3: Phone (tap-to-call) -->
    <TextView
        android:id="@+id/phone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textSize="13sp"
        android:textColor="#1570EF"
        android:drawablePadding="4dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp" />

    <!-- Row 4: Address (tap to open maps) -->
    <TextView
        android:id="@+id/address"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textSize="12sp"
        android:textColor="#1570EF"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- Row 5: Assigned X min ago + GPS proximity -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/assignedMins"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="11sp"
            android:textColor="#98A2B3" />

        <!-- GPS proximity chip — shows distance to destination when known -->
        <TextView
            android:id="@+id/proximityChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#344054"
            android:background="#F2F4F7"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Row 6: Arrival banner — prominent green strip when near destination -->
    <TextView
        android:id="@+id/arrivalBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:padding="10dp"
        android:gravity="center"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="#059669"
        android:visibility="gone" />

    <!-- Row 7: Navigate button (Task #1508) — tap to open Google Maps nav -->
    <Button
        android:id="@+id/navigateBtn"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="#1570EF"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:text="@string/navigate_btn"
        android:visibility="gone" />

    <!-- Row 8: Bill preview — visible only for current assigned/dispatched bills. -->
    <Button
        android:id="@+id/billPreviewBtn"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="#475467"
        android:contentDescription="@string/bill_preview_content_description"
        android:text="@string/bill_preview_btn"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Row 9: Delivered button (v1.6.0, Task #1160) — visible only while the
         bill is assigned/dispatched; MainActivity toggles visibility. -->
    <Button
        android:id="@+id/deliveredBtn"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="#059669"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:text="@string/delivered_btn"
        android:visibility="gone" />

</LinearLayout>
