{
  "slug": "app-install-pwa",
  "baseUrl": "https://127.0.0.1:5443",
  "title": "NestPOS App Install — Computer aur Mobile",
  "scenes": [
    { "id": "s01_intro", "card": { "heading": "NestPOS App", "sub": "Computer aur mobile par — ek click install" }, "minMs": 4500 },
    {
      "id": "s02_install",
      "actions": [
        { "do": "goto", "url": "/pos/login" },
        { "do": "wait", "ms": 900 },
        { "do": "type", "selector": "#login", "text": "videodemo@nestpos.pk", "delay": 40 },
        { "do": "type", "selector": "#password", "text": "NestPOS@Demo1", "delay": 40 },
        { "do": "click", "selector": "button[type=submit]", "after": 1500 },
        { "do": "waitFor", "selector": ".prod-card" },
        { "do": "goto", "url": "/pos/customers" },
        { "do": "wait", "ms": 1000 },
        { "do": "eval", "js": "document.querySelectorAll('button').forEach(function(b){ if ((b.getAttribute('@click')||'').indexOf('profileOpen = !profileOpen') !== -1) b.id = 'tnVidProf'; })" },
        { "do": "click", "selector": "#tnVidProf", "after": 1000 },
        { "do": "eval", "js": "var els = document.querySelectorAll('a[id^=tnPwaMi]'); for (var i = 0; i < els.length; i++) { if (els[i].offsetParent !== null) { els[i].id = 'tnVidPwa'; break; } }" },
        { "do": "highlight", "selector": "#tnVidPwa", "after": 1800 }
      ]
    },
    {
      "id": "s03_mobile",
      "actions": [
        { "do": "highlight", "selector": "#tnVidPwa", "after": 1500 },
        { "do": "wait", "ms": 1200 }
      ]
    },
    { "id": "s04_outro", "card": { "heading": "App tayyar!", "sub": "Ek click — NestPOS hazir" }, "minMs": 5000 }
  ]
}
