{
  "slug": "day-opening",
  "baseUrl": "https://127.0.0.1:5443",
  "title": "Day Opening — Opening Cash",
  "scenes": [
    {
      "id": "s01_intro",
      "card": {
        "heading": "Din ki Shuruat",
        "sub": "Opening cash — hisaab pehle minute se"
      },
      "minMs": 5000,
      "narration": "अस्सलामु अलैकुम दिन की सही शुरुआत यानि ओपनिंग कैश यह छोटी सी आदत आपका पूरा हिसाब सीधा रखती है आइए देखें"
    },
    {
      "id": "s02_form",
      "actions": [
        {
          "do": "goto",
          "url": "/pos/login"
        },
        {
          "do": "wait",
          "ms": 900
        },
        {
          "do": "type",
          "selector": "#login",
          "text": "videodemo@nestpos.pk",
          "delay": 40
        },
        {
          "do": "type",
          "selector": "#password",
          "text": "NestPOS@Demo1",
          "delay": 40
        },
        {
          "do": "click",
          "selector": "button[type=submit]",
          "after": 1500
        },
        {
          "do": "waitFor",
          "selector": ".prod-card"
        },
        {
          "do": "goto",
          "url": "/pos/dashboard"
        },
        {
          "do": "wait",
          "ms": 1200
        },
        {
          "do": "eval",
          "js": "var f = document.querySelector(\"form[action*='day-opening']\"); if (f) f.scrollIntoView({behavior:'smooth', block:'center'})"
        },
        {
          "do": "wait",
          "ms": 1000
        },
        {
          "do": "highlight",
          "selector": "form[action*='day-opening']",
          "after": 1500
        }
      ],
      "narration": "सुबह डैशबोर्ड खोलें, यहाँ ओपनिंग कैश का खाना है। गल्ले में जितनी रकम से दिन शुरू कर रहे हैं वही लिखें।"
    },
    {
      "id": "s03_save",
      "actions": [
        {
          "do": "type",
          "selector": "input[name='opening_cash']",
          "text": "5000",
          "delay": 120
        },
        {
          "do": "wait",
          "ms": 600
        },
        {
          "do": "click",
          "selector": "form[action*='day-opening'] button[type=submit]",
          "after": 2000
        }
      ],
      "narration": "जैसे पाँच हज़ार सेव करें, बस। अब रात को डे क्लोज पर सिस्टम खुद बताएगा कि गल्ले में कितनी रकम होनी चाहिए।"
    },
    {
      "id": "s04_outro",
      "card": {
        "heading": "Hisaab seedha, din aaram se",
        "sub": "Raat ko day close — sab khud milta hai"
      },
      "minMs": 5000,
      "narration": "ओपनिंग कैश से डे क्लोज तक Nest POS हिसाब की हर कड़ी जोड़ता है। Nest POS आसान भी, तेज भी।"
    }
  ]
}
