Dialogue: 0,0:00:00.50,0:00:04.51,Caption,,0,0,0,,Assalam o Alaikum! Aaj NestPOS mein Deals seekhte hain.
Dialogue: 0,0:00:04.51,0:00:08.22,Caption,,0,0,0,,Deal yani kai items ka combo — ek fixed qeemat par.
Dialogue: 0,0:00:08.22,0:00:11.72,Caption,,0,0,0,,Do qism ki deals hoti hain: Regular aur Special.
Dialogue: 0,0:00:11.72,0:00:15.65,Caption,,0,0,0,,Deal banana, handle karna aur bechna — teeno dekhenge.
Dialogue: 0,0:00:17.55,0:00:20.31,Caption,,0,0,0,,Customize mein se Deals ka page kholen.
Dialogue: 0,0:00:20.31,0:00:23.35,Caption,,0,0,0,,Yahan aap ki tamam deals ki list rehti hai.
Dialogue: 0,0:00:23.35,0:00:27.03,Caption,,0,0,0,,Har deal par items, qeemat, din aur status ka badge.
Dialogue: 0,0:00:31.72,0:00:34.45,Caption,,0,0,0,,Nai deal ke liye upar wala form bharein.
Dialogue: 0,0:00:34.45,0:00:37.11,Caption,,0,0,0,,Naam: Student Deal — qeemat: 499 rupay.
Dialogue: 0,0:00:37.11,0:00:40.24,Caption,,0,0,0,,Description mein likhein deal mein kya milega.
Dialogue: 0,0:00:42.14,0:00:45.40,Caption,,0,0,0,,Deal type chunein — Regular deal rozana chalti hai.
Dialogue: 0,0:00:45.40,0:00:49.05,Caption,,0,0,0,,Neeche din ke buttons se tay karein deal kin dinon chale.
Dialogue: 0,0:00:49.05,0:00:51.74,Caption,,0,0,0,,Misal ke taur par sirf Monday aur Tuesday.
Dialogue: 0,0:00:51.74,0:00:54.49,Caption,,0,0,0,,Koi din na chunein to deal har roz chalegi.
Dialogue: 0,0:00:56.40,0:00:59.12,Caption,,0,0,0,,Ab batayein deal mein milega kya.
Dialogue: 0,0:00:59.12,0:01:01.43,Caption,,0,0,0,,Pehli item: Chicken Biryani.
Dialogue: 0,0:01:01.43,0:01:04.90,Caption,,0,0,0,,Add Item daba kar doosri item: Soft Drink.
Dialogue: 0,0:01:04.90,0:01:08.12,Caption,,0,0,0,,Har item ki tadaad bhi likh sakte hain.
Dialogue: 0,0:01:10.02,0:01:15.66,Caption,,0,0,0,,Customer ki choice ke liye Cashier choice add karein.
Dialogue: 0,0:01:15.66,0:01:20.65,Caption,,0,0,0,,Naam likhein: Apni Drink Chunein — quantity: 2.
Dialogue: 0,0:01:20.65,0:01:25.11,Caption,,0,0,0,,Neeche tamam allowed drinks select karein.
Dialogue: 0,0:01:25.11,0:01:32.02,Caption,,0,0,0,,Fixed items aur choice groups ek deal mein saath chal sakte hain.
Dialogue: 0,0:01:33.92,0:01:35.74,Caption,,0,0,0,,Bas, Add Deal daba dein.
Dialogue: 0,0:01:35.74,0:01:39.09,Caption,,0,0,0,,Student Deal tayyar hokar list mein aa gayi.
Dialogue: 0,0:01:39.09,0:01:43.87,Caption,,0,0,0,,Sirf Mon aur Tue chuna tha — unhi dinon sale screen par aayegi.
Dialogue: 0,0:01:45.77,0:01:49.48,Caption,,0,0,0,,Doosri qism: Special deal — sirf khaas waqt ki offer.
Dialogue: 0,0:01:49.48,0:01:53.47,Caption,,0,0,0,,Karahi Night sirf Friday, Saturday aur Sunday chalti hai.
Dialogue: 0,0:01:53.47,0:01:55.57,Caption,,0,0,0,,Raat 7 baje se 11:30 baje tak.
Dialogue: 0,0:01:55.57,0:01:58.37,Caption,,0,0,0,,Din mein 20 deals ki limit bhi lagi hai.
Dialogue: 0,0:01:58.37,0:02:01.73,Caption,,0,0,0,,Waqt guzarte hi deal sale screen se khud ghayab.
Dialogue: 0,0:02:03.63,0:02:06.32,Caption,,0,0,0,,Bani hui deal ko handle karna bhi asaan hai.
Dialogue: 0,0:02:06.32,0:02:09.49,Caption,,0,0,0,,All par wapas aayen aur deal ke samne Edit dabayein.
Dialogue: 0,0:02:09.49,0:02:12.72,Caption,,0,0,0,,Naam, qeemat, items aur din yahan se badal jate hain.
Dialogue: 0,0:02:12.72,0:02:16.43,Caption,,0,0,0,,Active ka nishan hata dein to deal sale screen se hat jayegi.
Dialogue: 0,0:02:16.43,0:02:18.63,Caption,,0,0,0,,Magar record mein mehfooz rehti hai.
Dialogue: 0,0:02:20.53,0:02:23.65,Caption,,0,0,0,,Deal ki zaroorat na rahe to Delete daba dein.
Dialogue: 0,0:02:23.65,0:02:27.40,Caption,,0,0,0,,Delete karne se puranay bills par koi asar nahi parta.
Dialogue: 0,0:02:27.40,0:02:31.21,Caption,,0,0,0,,Har bill deal ke items ki copy khud mehfooz rakhta hai.
Dialogue: 0,0:02:33.11,0:02:36.19,Caption,,0,0,0,,Ab bechte hain — sale screen par aayen.
Dialogue: 0,0:02:36.19,0:02:38.55,Caption,,0,0,0,,Category mein Deals chun lein.
Dialogue: 0,0:02:38.55,0:02:41.86,Caption,,0,0,0,,Tamam chalti hui deals samne aa jati hain.
Dialogue: 0,0:02:43.76,0:02:49.57,Caption,,0,0,0,,Customer ne Family Deal mangwai? Card par click karein.
Dialogue: 0,0:02:49.57,0:02:54.12,Caption,,0,0,0,,Drink choice ho to pehle picker khulta hai.
Dialogue: 0,0:02:54.12,0:03:00.04,Caption,,0,0,0,,Customer ki drink chunein aur Add Deal to Cart dabayein.
Dialogue: 0,0:03:00.04,0:03:07.12,Caption,,0,0,0,,Fixed aur chosen dono items cart aur receipt mein saaf dikhte hain.
Dialogue: 0,0:03:09.02,0:03:12.55,Caption,,0,0,0,,Ab payment — wahi ek button, CASH.
Dialogue: 0,0:03:12.55,0:03:18.90,Caption,,0,0,0,,Receipt par fixed aur chosen items alag alag likhe aate hain.
Dialogue: 0,0:03:18.90,0:03:25.87,Caption,,0,0,0,,Stock aur recipe usi chosen product ka khud-ba-khud minus hota hai.
Dialogue: 0,0:03:25.87,0:03:32.74,Caption,,0,0,0,,Qeemat system khud lagata hai — ghalat rate ya choice mumkin nahi.
