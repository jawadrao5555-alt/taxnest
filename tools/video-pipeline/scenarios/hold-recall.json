    {
      "id": "s05_recall",
      "narration": "पहला گا ہَک aata ले कर वापस आ गया। ऊपर Held का बटन दबाएं — रुके हुए तमाम bill यहां हैं, वक़्त के साथ। Recall दबाएं — पूरा bill जैसे का तैसा वापस आ गया।",
      "actions": [
        { "do": "highlight", "selector": "button[\\@click=\"activeHeldIndex = 0; showHeldOrders = !showHeldOrders\"] >> nth=0", "after": 2000 },
        { "do": "click", "selector": "button[\\@click=\"activeHeldIndex = 0; showHeldOrders = !showHeldOrders\"] >> nth=0", "after": 2000 },
        { "do": "wait", "ms": 1500 },
        { "do": "click", "selector": "div[x-show='showHeldOrders'] button:has-text('Recall')", "after": 2500 }
