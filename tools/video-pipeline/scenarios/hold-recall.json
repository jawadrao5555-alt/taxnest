    {
      "id": "s02_first_bill",
      "narration": "sale screen पर पहले گا ہَک का bill बन रहा है — cheeni, cooking oil, और doodh। इतने में گا ہَک कहता है — भाई, aata भी लेना है, ज़रा देख कर आता हूं। अब counter ख़ाली नहीं रोक सकते।",
      "actions": [
        { "do": "goto", "url": "/pos/login" },
        { "do": "wait", "ms": 700 },
        { "do": "type", "selector": "#login", "text": "videodemo@nestpos.pk", "delay": 40 },
        { "do": "type", "selector": "#password", "text": "NestPOS@Demo1", "delay": 40 },
        { "do": "click", "selector": "form[action*='login'] button[type=submit]", "after": 1500 },
        { "do": "goto", "url": "/pos/invoice/create" },
        { "do": "waitFor", "selector": ".prod-card" },
        { "do": "wait", "ms": 1500 },
        { "do": "click", "selector": ".prod-card:has-text('Cheeni 1kg')", "after": 1000 },
        { "do": "click", "selector": ".prod-card:has-text('Cooking Oil 1L')", "after": 1000 },
        { "do": "click", "selector": ".prod-card:has-text('Doodh 1L')", "after": 1500 }
      ]
    },
    {
      "id": "s03_hold",
      "narration": "अब Hold का बटन दबाएं — या keyboard से सिर्फ़ F5। bill مح़फ़ूज़ हो गया और screen ख़ाली — अगले گا ہَک के लिए बिल्कुल तैयार।",
      "actions": [
        { "do": "highlight", "selector": "button[\\@click=\"holdOrder()\"]", "after": 2000 },
        { "do": "click", "selector": "button[\\@click=\"holdOrder()\"]", "after": 2500 },
        { "do": "wait", "ms": 1500 }
      ]
    },
    {
      "id": "s04_second_customer",
      "narration": "दूसरा گا ہَک आया — सिर्फ़ एक Pepsi और chips। फटाफट bill बनाएं, CASH दबाएं — और वो अपनी राह लगा।",
      "actions": [
        { "do": "click", "selector": ".prod-card:has-text('Pepsi 1.5L')", "after": 1000 },
        { "do": "click", "selector": ".prod-card:has-text('Lays Chips')", "after": 1500 },
        { "do": "click", "selector": "button.bg-purple-600:has-text('CASH')", "after": 3000 },
        { "do": "press", "selector": "body", "key": "Escape", "after": 1200 }
