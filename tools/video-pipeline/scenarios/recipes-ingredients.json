{
  "slug": "recipes-ingredients",
  "baseUrl": "https://127.0.0.1:5443",
  "title": "Ingredients aur Recipes — Kitchen ka Stock Khud-ba-Khud",
  "scenes": [
    {
      "id": "s01_intro",
      "card": {
        "heading": "Ingredients aur Recipes",
        "sub": "Saman ka stock · Recipe banayen · Sale par khud minus"
      },
      "narration": "अस्सलामु अलैकुम! आज NestPOS में Product, Kitchen Item और Recipe का connection देखें। Product customer को बेचा जाता है। Kitchen Item कच्चा सामान है। Recipe बताती है के एक Product बनाने में कितना सामान लगता है।",
      "minMs": 6000
    },
    {
      "id": "s02_ingredients_page",
      "narration": "Menu से Ingredients खोलें। यहां kitchen का कच्चा सामान दर्ज होता है — जैसे चावल, chicken, oil और sauce। हर item का unit, rate, मौजूदा stock और कम से कम stock limit यहां दिखती है। stock limit से नीचे जाए, तो system खबरदार करता है।",
      "actions": [
        {
          "do": "goto",
          "url": "/pos/login"
        },
        {
          "do": "wait",
          "ms": 700
        },
        {
          "do": "type",
          "selector": "#login",
          "text": "videoresto@nestpos.pk",
          "delay": 40
        },
        {
          "do": "type",
          "selector": "#password",
          "text": "{{VIDEO_DEMO_PASS}}",
          "delay": 40
        },
        {
          "do": "click",
          "selector": "form[action*='login'] button[type=submit]",
          "after": 1500
        },
        {
          "do": "goto",
          "url": "/pos/restaurant/ingredients"
        },
        {
          "do": "wait",
          "ms": 2000
        },
        {
          "do": "highlight",
          "selector": "div:has-text('Basmati Chawal') >> nth=-1",
          "after": 3000
        }
      ]
    },
    {
      "id": "s03_add_ingredient",
      "narration": "नया Kitchen Item add करने के लिए Add Ingredient दबाएं। नाम लिखें Tamatar, unit kg चुनें, rate नब्बे रुपये लिखें, stock बीस kg और कम से कम limit पांच रखें। अब Save दबाएं — kitchen का सामान record में शामिल हो गया।",
      "actions": [
        {
          "do": "click",
          "selector": "button[\\@click=\"showAddModal = true\"]",
          "after": 1500
        },
        {
          "do": "type",
          "selector": "div[x-show='showAddModal'] input[name='name']",
          "text": "Tamatar",
          "delay": 70,
          "after": 600
        },
        {
          "do": "select",
          "selector": "div[x-show='showAddModal'] select[name='unit']",
          "after": 800,
          "value": "kg"
        },
        {
          "do": "type",
          "selector": "div[x-show='showAddModal'] input[name='cost_per_unit']",
          "text": "90",
          "delay": 70,
          "after": 600
        },
        {
          "do": "type",
          "selector": "div[x-show='showAddModal'] input[name='current_stock']",
          "text": "20",
          "delay": 70,
          "after": 600
        },
        {
          "do": "type",
          "selector": "div[x-show='showAddModal'] input[name='min_stock_level']",
          "text": "5",
          "delay": 70,
          "after": 800
        },
        {
          "do": "click",
          "selector": "div[x-show='showAddModal'] button[type=submit]",
          "after": 3000
        }
      ]
    },
    {
      "id": "s04_recipes",
      "narration": "अब Product को Kitchen Items के साथ जोड़ने के लिए Recipes खोलें। Beef Pulao की recipe देखें। एक plate के लिए पाव kilo चावल और पचास gram oil दर्ज है। एक Product में कई Kitchen Items, और एक Kitchen Item कई Products की recipes में इस्तेमाल हो सकता है।",
      "actions": [
        {
          "do": "goto",
          "url": "/pos/restaurant/recipes"
        },
        {
          "do": "wait",
          "ms": 2000
        },
        {
          "do": "highlight",
          "selector": "h3:has-text('Beef Pulao')",
          "after": 3500
        },
        {
          "do": "wait",
          "ms": 1500
        }
      ]
    },
    {
      "id": "s05_sale_deduction",
      "narration": "अब sale का असर देखें। Sale screen से एक Beef Pulao चुनें और CASH payment करें। Cart में add करने पर stock तुरंत कम नहीं होता। Bill final होने के बाद system recipe पढ़ता है और जितना सामान लगा हो, उतना Kitchen Stock से खुद minus कर देता है।",
      "actions": [
        {
          "do": "goto",
          "url": "/pos/invoice/create"
        },
        {
          "do": "waitFor",
          "selector": ".prod-card"
        },
        {
          "do": "wait",
          "ms": 1200
        },
        {
          "do": "click",
          "selector": "button[\\@click=\"setOrderType('takeaway')\"]",
          "after": 1500
        },
        {
          "do": "click",
          "selector": ".prod-card:has-text('Beef Pulao')",
          "after": 1500
        },
        {
          "do": "click",
          "selector": "button.bg-purple-600:has-text('CASH')",
          "after": 3000
        },
        {
          "do": "press",
          "selector": "body",
          "key": "Escape",
          "after": 1000
        },
        {
          "do": "goto",
          "url": "/pos/restaurant/ingredients"
        },
        {
          "do": "wait",
          "ms": 2000
        },
        {
          "do": "highlight",
          "selector": "div:has-text('Basmati Chawal') >> nth=-1",
          "after": 3500
        }
      ]
    },
    {
      "id": "s06_outro",
      "card": {
        "heading": "Shukriya!",
        "sub": "Recipe banayen — stock ka hisaab system par chhoren"
      },
      "narration": "याद रखें: Product customer को बेचा जाता है। Kitchen Item बनाने में खर्च होता है। और Recipe दोनों को मिलाती है। Recipe एक बार ठीक बना दें, तो हर final sale पर stock का हिसाब खुद चलता रहेगा। इस तरह manual गिनती नहीं करनी पड़ती। शुक्रिया!",
      "minMs": 5500
    }
  ]
}